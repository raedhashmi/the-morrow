# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://morrow:CHANGE_ME@localhost:5432/morrow?schema=public"

# ── Auth.js ─────────────────────────────────────────────
# Generate with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_URL="https://morrow.example.com"
AUTH_TRUST_HOST=true
# Google OAuth — console.cloud.google.com → Credentials → OAuth client (Web)
# Authorised redirect URI: https://morrow.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=""
# Must be on a domain verified in Resend
EMAIL_FROM="The Morrow <paper@yourdomain.com>"

# ── App ─────────────────────────────────────────────────
APP_URL="https://morrow.example.com"
# Protects /api/cron/daily — generate with: openssl rand -hex 24
CRON_SECRET=""

# ── Optional: keyed news APIs (RSS + Google News work with no key) ──
GUARDIAN_API_KEY=""   # open-platform.theguardian.com/access
GNEWS_API_KEY=""      # gnews.io
NEWSAPI_KEY=""        # newsapi.org — check plan terms before using in production

# ── Optional: AI editor (summaries, editor's note, takeaways) ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Dev only: use labelled sample stories when news feeds are unreachable
MORROW_FIXTURES=0
